# ==============================================================================
# MedGuide Backend - Environment Configuration Template
# Copy this file to .env (do NOT commit .env to version control)
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (Phase 2: MySQL & Flyway)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medguide_db
DB_USERNAME=root
DB_PASSWORD=YOUR_DB_PASSWORD

# JWT Security Configuration (For Phase 3: Auth & RBAC)
JWT_SECRET=replace_with_a_secure_base64_encoded_secret_key_at_least_256_bits_long
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000        # 15 minutes (in milliseconds)
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000    # 7 days (in milliseconds)

# CORS Configuration (Allowed Origins, comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000,http://127.0.0.1:3000

# Actuator & Monitoring
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

# External Services (For Future Phases - Notifications, OCR, AI, Storage)
# FIREBASE_CREDENTIALS_PATH=
# OCR_API_KEY=
# AI_API_KEY=
# CLOUD_STORAGE_BUCKET=
